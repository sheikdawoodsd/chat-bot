# Server Port
PORT=5000

# AI Provider (gemini, openai, claude)
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get your free key at https://aistudio.google.com/apikey (no credit card needed)
# Put your key with no quotes and no spaces around =:
GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_SELF_CHECK=true

# JWT Authentication Secret
JWT_SECRET=super_secret_nova_jwt_key_change_in_production_32chars

# SQLite Database Path (stored locally, easy to swap for Postgres/MongoDB)
DATABASE_PATH=data/nova.db

# Optional: OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Claude Configuration (if AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
